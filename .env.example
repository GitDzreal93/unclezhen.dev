# Production environment template. Copy to `.env` and fill real values.
# `.env` is gitignored — this file is the safe, secret-free reference.

# PostgreSQL (db service). Use a strong ALPHANUMERIC password so the DSN
# needs no URL-encoding.
POSTGRES_USER=unclezhen
POSTGRES_PASSWORD=change-me-strong-alphanumeric
POSTGRES_DB=unclezhen
POSTGRES_DSN=postgres://unclezhen:change-me-strong-alphanumeric@db:5432/unclezhen?sslmode=disable

NODE_ENV=production

# Admin login password (the session signing key is derived from this — strong!)
ADMIN_PASSWORD=change-me-strong

# Public site URL (used to build payment notify/return URLs)
SITE_URL=https://your-domain.example

# z-pay (易支付) — real merchant id/key from your gateway
ZPAY_URL=https://zpayz.cn
ZPAY_PID=
ZPAY_KEY=

# GitHub image host (blog/material images)
GH_IMG_TOKEN=ghp_your_github_pat
GH_IMG_USER=
GH_IMG_REPO=
GH_IMG_BRANCH=main
GH_IMG_DIR=img
GH_IMG_HOST=https://cdn.jsdelivr.net/gh
